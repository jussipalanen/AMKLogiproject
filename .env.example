# Copy to .env to override docker-compose.yml defaults.
APP_PORT=8080
MAILPIT_PORT=8025
# Network interface for the ports: 127.0.0.1 = this machine only (safe default),
# 0.0.0.0 = all networks (servers; put HTTPS in front and set SEED_DEMO_DATA=false).
APP_BIND=127.0.0.1
MAILPIT_BIND=127.0.0.1

YII_ENV=prod
YII_DEBUG=0
APP_TIMEZONE=Europe/Helsinki

DB_DATABASE=amklogi
DB_USERNAME=amklogi
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

ADMIN_EMAIL=admin@amklogi.test
SENDER_EMAIL=noreply@amklogi.test

# Leave empty to generate one into the runtime volume on first start.
COOKIE_VALIDATION_KEY=

# Create demo users (matti, liisa, admin / demo1234) when the database is empty.
SEED_DEMO_DATA=true
